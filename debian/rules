#!/usr/bin/make -f

%:
	dh $@ --with vdrplugin

override_dh_auto_test:
	$(MAKE) check-navigation check-artwork check-epg-timeline check-logos check-recording-browser check-photo-gallery check-photo-carousel check-settings-navigation check-core-admin-navigation check-core-admin-http check-skin-registration

override_dh_auto_install:
	api=$$(pkg-config --variable=apiversion vdr); test -n "$$api" && \
	  install -D -m 0644 libvdr-suiteosd.so debian/vdr-plugin-suiteosd/usr/lib/vdr/plugins/libvdr-suiteosd.so.$$api
